{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerofuss",
  "version": "0.1.0",
  "identifier": "id.zerofuss.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "width": 460,
        "height": 300,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": false,
        "backgroundColor": "#0a0c0f"
      },
      {
        "label": "main",
        "title": "Zerofuss",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#0a0c0f",
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
